<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvTituloMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ejercicios con RadioButtons"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="24dp" />

        <Button
            android:id="@+id/btnEncuesta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Encuesta de Satisfacción" />

        <Button
            android:id="@+id/btnTema"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. Selector de Tema"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btnQuiz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3. Quiz Simple"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btnPropinas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="4. Calculadora de Propinas"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btnConversor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="5. Conversor de Unidades"
            android:layout_marginTop="12dp" />

    </LinearLayout>

</ScrollView>